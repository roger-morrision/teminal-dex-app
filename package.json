    "qa:runtime:stop": "node scripts/verified-qa-runtime.mjs stop",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "diagnostics:expo": "expo install --check",
    "diagnostics:doctor": "node scripts/run-expo-doctor.mjs",
    "test": "jest --runInBand",
