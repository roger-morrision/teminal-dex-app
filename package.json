  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "dev": "expo start --dev-client",
    "dev:verified": "node scripts/start-verified.mjs",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "serve:web-export": "node scripts/serve-web-export.mjs",
