{
  "expo": {
    "name": "Terminal DEX",
    "slug": "terminal-dex",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "terminaldex",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "./plugins/withNetworkSecurity",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Allow Terminal DEX to re-authenticate before showing verified wallet data." }
      ],
      "@preeternal/react-native-cookie-manager"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.terminaldex.mobile",
      "infoPlist": { "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false } }
    },
    "android": {
      "package": "app.terminaldex.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "terminaldex" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
